{
  "name": "coursepilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @coursepilot/web dev",
    "lint:web": "pnpm --filter @coursepilot/web lint",
    "typecheck:web": "pnpm --filter @coursepilot/web typecheck",
    "build:web": "pnpm --filter @coursepilot/web build",
    "check:web": "pnpm --filter @coursepilot/web check"
  }
}
