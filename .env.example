# Copy this file to .env for local Docker Compose development.
# Every credential below is a non-secret placeholder and must be replaced outside local use.

COMPOSE_PROJECT_NAME=coursepilot
COURSEPILOT_IMAGE_TAG=dev

WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

POSTGRES_DB=coursepilot
POSTGRES_USER=coursepilot
POSTGRES_PASSWORD=local-postgres-password-change-me
DATABASE_URL=postgresql+asyncpg://coursepilot:local-postgres-password-change-me@postgres:5432/coursepilot

REDIS_PASSWORD=local-redis-password-change-me
REDIS_URL=redis://:local-redis-password-change-me@redis:6379/0

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=local-neo4j-password-change-me

JWT_SECRET=replace-with-a-random-string-at-least-32-bytes-long
JWT_ISSUER=coursepilot-api
JWT_AUDIENCE=coursepilot-web
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
INVITE_TTL_DAYS=30

# The local stack checks PostgreSQL, Redis, Neo4j and the index directory.
# Enable the LLM readiness check only after configuring a reachable provider.
READINESS_CHECK_REDIS=true
READINESS_CHECK_NEO4J=true
READINESS_CHECK_INDEX=true
READINESS_CHECK_LLM=false
READINESS_CHECK_MIGRATIONS=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=replace-with-an-openai-compatible-model

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
UPLOAD_ROOT=/data/uploads
INDEX_ROOT=/data/indexes
HF_HOME=/data/models/huggingface

# Browser traffic stays same-origin; only the Next.js server uses this address.
API_INTERNAL_URL=http://api:8000

CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2
